{
  "title": "Echo Room Overview",
  "uid": "echo-room-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Requests per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_requests_total[1m])) by (route, status_code)", "legendFormat": "{{route}} [{{status_code}}]" }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Request Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 3,
      "title": "Active Socket.IO Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "socket_active_connections", "legendFormat": "connections" }
      ]
    },
    {
      "id": 4,
      "title": "Chat Messages per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(rate(messages_sent_total[1m])) by (type)", "legendFormat": "{{type}}" }
      ]
    },
    {
      "id": 5,
      "title": "Process Memory (RSS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "process_resident_memory_bytes", "legendFormat": "RSS bytes" }
      ]
    },
    {
      "id": 6,
      "title": "Event Loop Lag (p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "nodejs_eventloop_lag_p99_seconds", "legendFormat": "lag p99" }
      ]
    }
  ]
}
